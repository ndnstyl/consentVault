{
  "about": "Every setting, secret and file path the ConsentVault product reads, per service and scheduled job. tests/test_cloud_settings.py fails when the product reads a name this list lacks, or this list names one the product never reads; the KMS plugin's names are checked by its own tests. A secret_file is injected as the environment value injected_as and written to path by docker/cloud-entrypoint.sh (mode 600), which then removes the value from the environment.",
  "kinds": {
    "setting": "a plain value",
    "secret_value": "a secret read straight from the environment",
    "secret_file": "a file holding a secret",
    "file": "a file path",
    "directory": "a folder path",
    "platform": "set by the platform, never by hand"
  },
  "used_by": {
    "vault": "consentvault serve-cloud (cloud) or serve (self-host)",
    "sync": "python -m consentvault.sync",
    "migrate": "consentvault migrate",
    "job:<name>": "python -m consentvault.jobs <name>",
    "job:*": "every scheduled job"
  },
  "settings": [
    {
      "name": "AWS_CONTAINER_AUTHORIZATION_TOKEN",
      "kind": "platform",
      "required": "one of the credential URIs, set by Fargate",
      "used_by": [
        "vault",
        "sync",
        "job:*"
      ],
      "read_by": "product",
      "deployments": [
        "cloud"
      ]
    },
    {
      "name": "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE",
      "kind": "platform",
      "required": "one of the credential URIs, set by Fargate",
      "used_by": [
        "vault",
        "sync",
        "job:*"
      ],
      "read_by": "product",
      "deployments": [
        "cloud"
      ]
    },
    {
