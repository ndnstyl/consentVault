# Test runner for the self-host stack. It runs INSIDE the same virtual machine clock as the database, on the database's
# own network, because several product tests compare a time the database stamps with a time the test process reads and
# fail when the two clocks differ by even a tenth of a second (a Colima or Docker Desktop VM drifts that much from its host).
# Dependencies are pinned to the versions the repository's own environment runs; the source is mounted, not copied.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl postgresql-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "psycopg[binary]==3.3.6" "cryptography==50.0.2" "pytest==9.2.0"

# The runner never needs root: the source is mounted read-only and every test writes only under its own temp folders.
RUN useradd --system --uid 10002 --create-home suites
USER suites

ENV PYTHONPATH=/repo/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PG_BIN=/usr/bin
WORKDIR /repo
ENTRYPOINT ["python", "-m", "pytest", "-p", "no:cacheprovider", "-p", "tests.selfhost.suites_plugin", "-q"]
