# Copy to wrangler.toml and edit. Secrets are never written here; set them
# with the Cloudflare CLI's secret command: SIGNING_SECRET (required) and
# TURNSTILE_SECRET (optional).
name = "consentvault-edge"
main = "src/worker.ts"
compatibility_date = "2026-01-01"

[vars]
# Comma-separated list of exact origins allowed to post consent.
ALLOWED_ORIGINS = "https://www.example.com"
# Base URL of the vault API (the worker appends /v1/events).
VAULT_URL = "https://vault.example.com"
# Free-text id of this capture surface, stored on every event.
SOURCE_ID = "site-form"

# Optional durable store, so a request is never lost while the vault is down: with both bindings the edge keeps the body in
# the bucket and one small message in the queue, answers 202 with the body's fingerprint, and delivers in arrival order.
# Without them a request that arrives while the vault is down is answered 503 store_unavailable ("nothing was stored").
# [[r2_buckets]]
# binding = "BODY_STORE"
# bucket_name = "consentvault-edge-bodies"
#
# [[queues.producers]]
# binding = "CAPTURE_QUEUE"
# queue = "consentvault-edge-capture"
#
# [[queues.consumers]]
# queue = "consentvault-edge-capture"
# max_batch_size = 10
# max_retries = 100
